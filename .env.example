# Variables de l'album en ligne (à définir dans Vercel → Settings → Environment Variables).
# Ne mets JAMAIS de vraies valeurs dans ce fichier : il est versionné.

# --- Stockage : choisis UNE des deux options -------------------------------
# Option A — Vercel Blob (privé). Ajoutée automatiquement par Vercel quand tu
# connectes un magasin Blob au projet.
BLOB_READ_WRITE_TOKEN=

# Option B — Supabase (bucket privé + table « souvenirs », voir supabase/schema.sql).
# URL du projet (Settings → API) et clé SECRÈTE côté serveur (service_role ou sb_secret_…).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Facultatif : SUPABASE_BUCKET=souvenirs  SUPABASE_TABLE=souvenirs

# --- Accès à l'album ---------------------------------------------------------

# Code à partager avec elle : voir l'album.
ALBUM_CODE=
# Ton code à toi : voir, envoyer et supprimer des souvenirs. Différent du précédent.
ADMIN_CODE=
# Longue chaîne aléatoire qui signe les sessions (ex. : openssl rand -hex 32).
SESSION_SECRET=

# Facultatif : taille maximale d'un fichier en Mo (1024 avec Vercel Blob, 50 avec Supabase).
# TAILLE_MAX_MO=1024
