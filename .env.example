# Variables de l'album en ligne (à définir dans Vercel → Settings → Environment Variables).
# Ne mets JAMAIS de vraies valeurs dans ce fichier : il est versionné.

# Ajoutée automatiquement par Vercel quand tu connectes un magasin Blob au projet.
BLOB_READ_WRITE_TOKEN=

# Code à partager avec elle : voir l'album.
ALBUM_CODE=
# Ton code à toi : voir, envoyer et supprimer des souvenirs. Différent du précédent.
ADMIN_CODE=
# Longue chaîne aléatoire qui signe les sessions (ex. : openssl rand -hex 32).
SESSION_SECRET=

# Facultatif : taille maximale d'un fichier en Mo (1024 par défaut).
# TAILLE_MAX_MO=1024
